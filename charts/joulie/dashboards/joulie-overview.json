{
  "annotations": {
    "list": []
  },
  "description": "Joulie cluster energy state overview: policy controller FSM, agent control signals, simulator telemetry",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Policy controller: FSM and profile",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "The policy state of each node: ActivePerformance (green), DrainingPerformance (orange: planned eco while performance pods still run on it, so it keeps its performance caps) or ActiveEco (blue).",
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "ActivePerformance", "color": "green", "index": 0 }, "2": { "text": "DrainingPerformance", "color": "orange", "index": 1 }, "3": { "text": "ActiveEco", "color": "blue", "index": 2 } } }]
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }
      },
      "title": "FSM State by Node",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "max by (node) (joulie_policy_node_state{node=~\"$node\",state=\"ActivePerformance\"}) + 2 * max by (node) (joulie_policy_node_state{node=~\"$node\",state=\"DrainingPerformance\"}) + 3 * max by (node) (joulie_policy_node_state{node=~\"$node\",state=\"ActiveEco\"})",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal"
      },
      "title": "Node Profile Distribution",
      "type": "bargauge",
      "targets": [
        {
          "expr": "count(joulie_policy_node_state{state=\"ActivePerformance\"} == 1)",
          "legendFormat": "Performance"
        },
        {
          "expr": "count(joulie_policy_node_state{state=\"ActiveEco\"} == 1)",
          "legendFormat": "Eco"
        },
        {
          "expr": "count(joulie_policy_node_state{state=\"DrainingPerformance\"} == 1)",
          "legendFormat": "Draining"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "The joulie.io/power-profile label of each node, performance (green) or eco (blue), which the scheduler extender and pod affinities read.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "performance", "color": "green", "index": 0 }, "2": { "text": "eco", "color": "blue", "index": 1 } } }]
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 3,
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }
      },
      "title": "Node Profile Label",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "max by (node) (joulie_policy_node_profile_label{node=~\"$node\",profile=\"performance\"}) + 2 * max by (node) (joulie_policy_node_profile_label{node=~\"$node\",profile=\"eco\"})",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Policy controller: transitions and families",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 50, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "title": "State Transitions (rate/5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (from_state, to_state, result) (rate(joulie_policy_state_transitions_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{from_state}} → {{to_state}} ({{result}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "title": "Performance nodes per family",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_policy_family_performance_nodes",
          "legendFormat": "{{family}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Agent: Backend & Power",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "How each node's agent enforces its CPU cap: a RAPL package limit (green), DVFS, a frequency limit, when RAPL is not writable (yellow), or none (grey).",
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "none", "color": "#808080", "index": 0 }, "1": { "text": "rapl", "color": "green", "index": 1 }, "2": { "text": "dvfs", "color": "yellow", "index": 2 } } }]
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }
      },
      "title": "Backend Mode",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "max by (node) (joulie_backend_mode{node=~\"$node\",mode=\"rapl\"}) + 2 * max by (node) (joulie_backend_mode{node=~\"$node\",mode=\"dvfs\"})",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 7,
      "title": "RAPL Package Power (per node)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_rapl_package_total_power_watts{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 8,
      "title": "Policy Cap (per node)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_policy_cap_watts{node=~\"$node\"}",
          "legendFormat": "{{node}} ({{policy}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Agent: DVFS Control",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 9,
      "title": "Observed vs EMA Power",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_dvfs_observed_power_watts{node=~\"$node\"}",
          "legendFormat": "{{node}} observed"
        },
        {
          "expr": "joulie_dvfs_ema_power_watts{node=~\"$node\"}",
          "legendFormat": "{{node}} EMA"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "custom": { "fillOpacity": 30 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 10,
      "title": "DVFS Throttle %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_dvfs_throttle_pct{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 11,
      "title": "DVFS Action Rates (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(joulie_dvfs_actions_total{action=\"throttle_up\",node=~\"$node\"}[5m])",
          "legendFormat": "{{node}} throttle_up/s"
        },
        {
          "expr": "rate(joulie_dvfs_actions_total{action=\"throttle_down\",node=~\"$node\"}[5m])",
          "legendFormat": "{{node}} throttle_down/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "title": "Agent: Reliability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 50 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "id": 12,
      "title": "Reconcile Errors (rate/5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (node) (rate(joulie_reconcile_errors_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 37 },
      "id": 13,
      "title": "CPU Frequency, Max and Current (avg per node)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "avg by (node) (joulie_dvfs_cpu_max_freq_khz{node=~\"$node\"}) * 1000",
          "legendFormat": "{{node}} max"
        },
        {
          "expr": "avg by (node) (joulie_dvfs_cpu_cur_freq_khz{node=~\"$node\"}) * 1000",
          "legendFormat": "{{node}} current"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Managed nodes whose NodeTwin reports AgentReporting False (joulie_twin_nodes_agent_reporting), by reason: the caps planned there are not enforced. The nodes are the NodeTwins with that condition.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 50 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 37 },
      "id": 36,
      "title": "Managed nodes without a reporting agent",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (joulie_twin_nodes_agent_reporting{status=\"false\"})",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "id": 109,
      "title": "Agent: Governors",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Nodes per governor preset in effect (joulie_agent_governor_state == 1): applied, applied-unverified or equivalent. Empty while governor control is off.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "id": 34,
      "title": "Nodes per governor preset in effect",
      "type": "timeseries",
      "targets": [
        {
          "expr": "count by (component, preset) (joulie_agent_governor_state{node=~\"$node\"} == 1)",
          "legendFormat": "{{component}} {{preset}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Governor writes per component, preset and result: a preset applied, or the baseline restored (preset=baseline). Steady writes with result drift mean another writer changes the setting.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 50, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "id": 35,
      "title": "Governor writes (rate/5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (component, preset, result) (rate(joulie_agent_governor_writes_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{component}} {{preset}} ({{result}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "id": 107,
      "title": "Scheduler Extender",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 55 },
      "id": 25,
      "title": "Filter & Prioritize Requests (rate/5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (workload_class) (rate(joulie_scheduler_filter_requests_total[5m]))",
          "legendFormat": "filter {{workload_class}}"
        },
        {
          "expr": "sum by (workload_class) (rate(joulie_scheduler_prioritize_requests_total[5m]))",
          "legendFormat": "prioritize {{workload_class}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 55 },
      "id": 26,
      "title": "Filter & Prioritize Latency (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(joulie_scheduler_filter_duration_seconds_bucket[5m])))",
          "legendFormat": "filter p99"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(joulie_scheduler_prioritize_duration_seconds_bucket[5m])))",
          "legendFormat": "prioritize p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 55 },
      "id": 27,
      "title": "Stale Twin Data",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_scheduler_stale_twin_data{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 63 },
      "id": 28,
      "title": "Final Node Score",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_scheduler_final_node_score{node=~\"$node\"}",
          "legendFormat": "{{node}} ({{workload_class}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 63 },
      "id": 29,
      "title": "Node Headroom Score",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_scheduler_node_headroom_score{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 71 },
      "id": 108,
      "title": "Twin inputs",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "IT and cooling power the controller manager's facility input last read (FACILITY_PRESET in the legend). Absent while unknown or with ENABLE_FACILITY_METRICS=false.",
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": { "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 72 },
      "id": 30,
      "title": "Facility power read by the twin (W)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_twin_facility_it_power_watts",
          "legendFormat": "IT ({{preset}})"
        },
        {
          "expr": "joulie_twin_facility_cooling_power_watts",
          "legendFormat": "cooling ({{preset}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "PUE from the twin's facility inputs: (IT + cooling) / IT, the formula the controller manager logs.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": { "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 72 },
      "id": 31,
      "title": "PUE from twin inputs",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(joulie_twin_facility_it_power_watts + joulie_twin_facility_cooling_power_watts) / joulie_twin_facility_it_power_watts",
          "legendFormat": "PUE ({{preset}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Outdoor ambient temperature the facility input last read.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 72 },
      "id": 32,
      "title": "Ambient temperature read by the twin",
      "type": "timeseries",
      "targets": [
        {
          "expr": "joulie_twin_facility_ambient_temperature_celsius",
          "legendFormat": "ambient ({{preset}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Prometheus queries of the measured inputs by input and result. A steady no_data or error rate means the twin runs without measured values; see the telemetry docs for the hints.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 72 },
      "id": 33,
      "title": "Input queries by result (rate/5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (input, result) (rate(joulie_twin_input_queries_total[5m]))",
          "legendFormat": "{{input}} {{result}}"
        }
      ]
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 80 },
      "id": 105,
      "title": "Simulator: Power & Utilization",
      "type": "row",
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "unit": "watt",
              "custom": { "fillOpacity": 20 }
            }
          },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 81 },
          "id": 14,
          "title": "Simulated Power vs Cap (W)",
          "type": "timeseries",
          "targets": [
            {
              "expr": "joulie_sim_node_power_watts{node=~\"$node\"}",
              "legendFormat": "{{node}} power"
            },
            {
              "expr": "joulie_sim_node_cap_watts{node=~\"$node\"}",
              "legendFormat": "{{node}} cap"
            }
          ]
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "fillOpacity": 20 },
              "unit": "percentunit",
              "max": 1,
              "min": 0
            }
          },
          "gridPos": { "h": 8, "w": 6, "x": 12, "y": 81 },
          "id": 15,
          "title": "CPU Utilization (sim)",
          "type": "timeseries",
          "targets": [
            {
              "expr": "joulie_sim_node_cpu_util{node=~\"$node\"}",
              "legendFormat": "{{node}}"
            }
          ]
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "fillOpacity": 20 },
              "unit": "percentunit",
              "max": 1,
              "min": 0
            }
          },
          "gridPos": { "h": 8, "w": 6, "x": 18, "y": 81 },
          "id": 16,
          "title": "Freq Scale (sim)",
          "type": "timeseries",
          "targets": [
            {
              "expr": "joulie_sim_node_freq_scale{node=~\"$node\"}",
