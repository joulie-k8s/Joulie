# Production timing of the simulated cluster (SIMCLUSTER_TIMING=production):
# the intervals of a real install, for nightly runs. The keys and their
# mapping are those of dev.env; RATE_WINDOW covers at least 4 OTLP export
# intervals.
CONTROLLER_RECONCILE_INTERVAL=1m
AGENT_RECONCILE_INTERVAL=20s
AGENT_SPEC_READ_TIMEOUT=5m
PROM_SCRAPE_INTERVAL=1m
OTLP_EXPORT_INTERVAL_MS=60000
RATE_WINDOW=5m
FACILITY_POLL_INTERVAL=30s
