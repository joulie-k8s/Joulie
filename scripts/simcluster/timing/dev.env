# Development timing of the simulated cluster (SIMCLUSTER_TIMING=dev, the
# default): short intervals, so a smoke run settles in minutes. The keys are
# harness names; the simcluster command maps them onto the real settings:
#
#   CONTROLLER_RECONCILE_INTERVAL  controller manager RECONCILE_INTERVAL
#   AGENT_RECONCILE_INTERVAL       agent RECONCILE_INTERVAL
#   AGENT_SPEC_READ_TIMEOUT        agent SPEC_READ_TIMEOUT
#   PROM_SCRAPE_INTERVAL           Prometheus global scrape_interval
#   OTLP_EXPORT_INTERVAL_MS        simulator otel.exportIntervalMillis
#   RATE_WINDOW                    controller manager PROMETHEUS_RATE_WINDOW
#   FACILITY_POLL_INTERVAL         controller manager FACILITY_POLL_INTERVAL
#
# RATE_WINDOW covers at least 4 OTLP export intervals, or rate() reads too
# few samples.
CONTROLLER_RECONCILE_INTERVAL=10s
AGENT_RECONCILE_INTERVAL=5s
AGENT_SPEC_READ_TIMEOUT=60s
PROM_SCRAPE_INTERVAL=5s
OTLP_EXPORT_INTERVAL_MS=5000
RATE_WINDOW=30s
FACILITY_POLL_INTERVAL=10s
