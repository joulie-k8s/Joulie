# Versions the simulated cluster pins, for local runs and CI alike. Sourced by
# scripts/simcluster/lib.sh; CI reads HELM_VERSION from here.
#
# Manifests reference images by tag. The digests are checked on the host
# after docker pull, because a digest reference does not survive
# docker save | ctr import: ctr import discards the index by default.

# k3s server; the same image as _K3S_IMAGE in ci/src/joulie_ci/__init__.py.
K3S_IMAGE=rancher/k3s:v1.34.1-k3s1

# KWOK release; kwok.yaml and stage-fast.yaml are vendored unmodified from its
# release assets under scripts/simcluster/manifests/kwok-v0.8.0/.
KWOK_VERSION=v0.8.0
KWOK_YAML_SHA256=a4c16e6431e382dcb5c1903139344b7a68652f16a6460337fe17a678a426f405
KWOK_STAGE_FAST_SHA256=2f28d95564ec43056c0873f7a25ac7d2a5bba4c8496c72f8b3ee73fd4f54ee24
# The KWOK controller image kwok.yaml runs; the digest is the multi-arch
# index. Imported like Prometheus, so a fresh cluster never pulls it.
KWOK_IMAGE=registry.k8s.io/kwok/kwok:v0.8.0
KWOK_DIGEST=sha256:6d25aa8fbdfe78845423160bf125b5513f9522e2770981f0945c2a250c2b26f0

# Prometheus with the OTLP receiver; the digest is the multi-arch index.
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
PROMETHEUS_DIGEST=sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e

# OpenTelemetry Collector core build, for the otel-collector mode.
OTELCOL_IMAGE=otel/opentelemetry-collector:0.162.0
OTELCOL_DIGEST=sha256:310a800ad69ee430e7c541796852a242c9c7db97aaad4daa5ccf843c525fbdb2

# OpenTelemetry Collector contrib build, for the otel-bridge mode: the bridge
# of examples/11-otel-collector-bridge needs its transform and groupbyattrs
# processors, which the core build lacks.
OTELCOL_CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.162.0
OTELCOL_CONTRIB_DIGEST=sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6

# Base image of the locally built Joulie images, at the release images' paths.
DISTROLESS_STATIC=gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

HELM_VERSION=v4.1.1

# k3s air-gap image bundle, used with SIMCLUSTER_AIRGAP=1; the sha256 is the
# release's sha256sum-amd64.txt entry.
K3S_AIRGAP_URL=https://github.com/k3s-io/k3s/releases/download/v1.34.1%2Bk3s1/k3s-airgap-images-amd64.tar.zst
K3S_AIRGAP_SHA256=27355d2838c727180f0a8ded8aec0ac14e2186bd50487a3c3f29500884121aa7
