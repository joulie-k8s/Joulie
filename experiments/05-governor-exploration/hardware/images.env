# Images of the hardware measurements, each named by tag and digest; the
# digest is what the node pulls. Sourced by hwmeasure.sh, which refuses an
# --image without a digest. Every image has bash, coreutils, util-linux
# (setsid, mount, chroot), tar and awk. nvidia-smi and rocm-smi come from
# the host (chroot into the host root) unless the image or the container
# runtime provides them.

# tools: stress-ng 0.22.01 on Debian 13 (bash 5.2), the image the stress-ng
# project builds from the commit of its V0.22.01 release.
HW_IMAGE_TOOLS=ghcr.io/colinianking/stress-ng:72a9d0cae0f420a887991d4024d3101c4af7a4fc@sha256:2ea9a7c3828eda1b1ca3d0b0c5a669ec252f9caf97a6a33aedcea6b2a66d1cbe

# cuda: nvcc 12.4, to build peercopy.cpp in the pod (the GPU needs a driver
# of the 525 series or newer). About 4 GB to pull.
HW_IMAGE_CUDA=docker.io/nvidia/cuda:12.4.1-devel-ubuntu22.04@sha256:da6791294b0b04d7e65d87b7451d6f2390b4d36225ab0701ee7dfec5769829f5

# rocm: hipcc and rocm-smi of ROCm 6.2.4, to build peercopy.cpp in the pod.
# About 1 GB to pull.
HW_IMAGE_ROCM=docker.io/rocm/dev-ubuntu-22.04:6.2.4@sha256:030304ab0a88778b627b2eb2354c419146e105f5ac39ffd9c2438c82ef54b584
