    max by ("k8s.node.name") ({"hw.host.ambient_temperature", "k8s.node.name"!=""} or {"hw.host.ambient_temperature", "k8s.node.name"=""} * on (job, instance) group_left ("k8s.node.name") max by (job, instance, "k8s.node.name") (target_info and on (job, instance) {"hw.host.ambient_temperature", "k8s.node.name"=""}))

preset=otel window=2m0s
ambient_temp group="" per_node=false
    avg(joulie_facility_ambient_temperature_celsius)
it_power group="" per_node=false
    sum(rate(joulie_facility_it_energy_joules_total[2m])) or sum(joulie_facility_it_power_watts)
cooling_power group="" per_node=false
    sum(rate(joulie_facility_cooling_energy_joules_total[2m])) or sum(joulie_facility_cooling_power_watts)
zone_ambient_temp group="joulie_cooling_zone_name" per_node=false
    avg by (joulie_cooling_zone_name) (joulie_cooling_zone_ambient_temperature_celsius)
rack_power group="joulie_rack_name" per_node=false
    sum by (joulie_rack_name) (rate(joulie_rack_energy_joules_total[2m])) or on (joulie_rack_name) sum by (joulie_rack_name) (joulie_rack_power_watts)
node_inlet_temp group="k8s_node_name" per_node=false
    max by (k8s_node_name) (hw_host_ambient_temperature_celsius{k8s_node_name!=""} or hw_host_ambient_temperature_celsius{k8s_node_name=""} * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info and on (job, instance) hw_host_ambient_temperature_celsius{k8s_node_name=""}))

preset=legacy
ambient_temp group="" per_node=false
    avg(datacenter_ambient_temperature_celsius)
it_power group="" per_node=false
    sum(datacenter_total_it_power_watts)
cooling_power group="" per_node=false
    sum(datacenter_cooling_power_watts)

preset=legacy override.ambient_temp="site_outdoor_temperature_celsius" override.it_power="sum(ups_output_power_watts{site=\"a\"})"
ambient_temp group="" per_node=false
    avg(site_outdoor_temperature_celsius)
it_power group="" per_node=false
    sum(ups_output_power_watts{site="a"})
cooling_power group="" per_node=false
    sum(datacenter_cooling_power_watts)

preset=custom

preset=custom naming=NoUTF8EscapingWithSuffixes override.cooling_power="chiller_power_watts" override.node_inlet_temp="ipmi_inlet_temperature_celsius" override.rack_power="pdu_power_watts" override.zone_ambient_temp="crac_return_temperature_celsius"
cooling_power group="" per_node=false
    sum(chiller_power_watts)
zone_ambient_temp group="joulie.cooling_zone.name" per_node=false
    avg by ("joulie.cooling_zone.name") (crac_return_temperature_celsius)
rack_power group="joulie.rack.name" per_node=false
    sum by ("joulie.rack.name") (pdu_power_watts)
node_inlet_temp group="k8s.node.name" per_node=false
    avg by ("k8s.node.name") (ipmi_inlet_temperature_celsius)

preset=otel override.node_inlet_temp="" override.rack_power="sum by (joulie_rack_name) (label_replace(pdu_power_watts, \"joulie_rack_name\", \"$1\", \"pdu\", \"(.*)\"))"
ambient_temp group="" per_node=false
    avg(joulie_facility_ambient_temperature_celsius)
it_power group="" per_node=false
    sum(rate(joulie_facility_it_energy_joules_total[5m])) or sum(joulie_facility_it_power_watts)
cooling_power group="" per_node=false
    sum(rate(joulie_facility_cooling_energy_joules_total[5m])) or sum(joulie_facility_cooling_power_watts)
zone_ambient_temp group="joulie_cooling_zone_name" per_node=false
    avg by (joulie_cooling_zone_name) (joulie_cooling_zone_ambient_temperature_celsius)
rack_power group="joulie_rack_name" per_node=false
    sum by (joulie_rack_name) (label_replace(pdu_power_watts, "joulie_rack_name", "$1", "pdu", "(.*)"))
node_inlet_temp group="k8s_node_name" per_node=false
    max by (k8s_node_name) (hw_host_ambient_temperature_celsius{k8s_node_name!=""} or hw_host_ambient_temperature_celsius{k8s_node_name=""} * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info and on (job, instance) hw_host_ambient_temperature_celsius{k8s_node_name=""}))
