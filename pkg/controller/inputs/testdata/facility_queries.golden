# Facility queries of package inputs, one case per block: the spec, then the query of
# each input it reads, in FacilityInputs order.
# Generated by TestFacilityQueriesGolden; rewrite with go test ./pkg/controller/inputs/ -update.

preset=otel naming=UnderscoreEscapingWithSuffixes
ambient_temp group="" per_node=false
    avg(joulie_facility_ambient_temperature_celsius)
it_power group="" per_node=false
    sum(rate(joulie_facility_it_energy_joules_total[5m])) or sum(joulie_facility_it_power_watts)
cooling_power group="" per_node=false
    sum(rate(joulie_facility_cooling_energy_joules_total[5m])) or sum(joulie_facility_cooling_power_watts)
zone_ambient_temp group="joulie_cooling_zone_name" per_node=false
    avg by (joulie_cooling_zone_name) (joulie_cooling_zone_ambient_temperature_celsius)
rack_power group="joulie_rack_name" per_node=false
    sum by (joulie_rack_name) (rate(joulie_rack_energy_joules_total[5m])) or on (joulie_rack_name) sum by (joulie_rack_name) (joulie_rack_power_watts)
node_inlet_temp group="k8s_node_name" per_node=false
    max by (k8s_node_name) (hw_host_ambient_temperature_celsius{k8s_node_name!=""} or hw_host_ambient_temperature_celsius{k8s_node_name=""} * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info and on (job, instance) hw_host_ambient_temperature_celsius{k8s_node_name=""}))

preset=otel naming=NoUTF8EscapingWithSuffixes
ambient_temp group="" per_node=false
    avg({"joulie.facility.ambient_temperature_celsius"})
it_power group="" per_node=false
    sum(rate({"joulie.facility.it.energy_joules_total"}[5m])) or sum({"joulie.facility.it.power_watts"})
cooling_power group="" per_node=false
    sum(rate({"joulie.facility.cooling.energy_joules_total"}[5m])) or sum({"joulie.facility.cooling.power_watts"})
zone_ambient_temp group="joulie.cooling_zone.name" per_node=false
    avg by ("joulie.cooling_zone.name") ({"joulie.cooling_zone.ambient_temperature_celsius"})
rack_power group="joulie.rack.name" per_node=false
    sum by ("joulie.rack.name") (rate({"joulie.rack.energy_joules_total"}[5m])) or on ("joulie.rack.name") sum by ("joulie.rack.name") ({"joulie.rack.power_watts"})
node_inlet_temp group="k8s.node.name" per_node=false
    max by ("k8s.node.name") ({"hw.host.ambient_temperature_celsius", "k8s.node.name"!=""} or {"hw.host.ambient_temperature_celsius", "k8s.node.name"=""} * on (job, instance) group_left ("k8s.node.name") max by (job, instance, "k8s.node.name") (target_info and on (job, instance) {"hw.host.ambient_temperature_celsius", "k8s.node.name"=""}))

preset=otel naming=UnderscoreEscapingWithoutSuffixes
ambient_temp group="" per_node=false
    avg(joulie_facility_ambient_temperature)
it_power group="" per_node=false
    sum(rate(joulie_facility_it_energy[5m])) or sum(joulie_facility_it_power)
cooling_power group="" per_node=false
    sum(rate(joulie_facility_cooling_energy[5m])) or sum(joulie_facility_cooling_power)
zone_ambient_temp group="joulie_cooling_zone_name" per_node=false
    avg by (joulie_cooling_zone_name) (joulie_cooling_zone_ambient_temperature)
rack_power group="joulie_rack_name" per_node=false
    sum by (joulie_rack_name) (rate(joulie_rack_energy[5m])) or on (joulie_rack_name) sum by (joulie_rack_name) (joulie_rack_power)
node_inlet_temp group="k8s_node_name" per_node=false
    max by (k8s_node_name) (hw_host_ambient_temperature{k8s_node_name!=""} or hw_host_ambient_temperature{k8s_node_name=""} * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info and on (job, instance) hw_host_ambient_temperature{k8s_node_name=""}))

preset=otel naming=NoTranslation
ambient_temp group="" per_node=false
    avg({"joulie.facility.ambient_temperature"})
it_power group="" per_node=false
    sum(rate({"joulie.facility.it.energy"}[5m])) or sum({"joulie.facility.it.power"})
