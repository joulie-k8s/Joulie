primary group="instance" per_node=false
    sum by (instance) (label_replace(rate(kepler_node_cpu_joules_total{zone="package"}[5m]), "joulie_component", "cpu", "", "") or label_replace(rate(kepler_node_gpu_joules_total[5m]), "joulie_component", "gpu", "", ""))

preset=kepler-legacy
primary group="exported_instance" per_node=false
