# Node power queries of package inputs, one case per block: the spec, then the
# primary query and, under resource attributes auto, the target_info fallback.
# Generated by TestNodePowerQueryGolden; rewrite with go test ./pkg/controller/inputs/ -update.

preset=otel scope=components naming=UnderscoreEscapingWithSuffixes resource_attributes=auto
primary group="k8s_node_name" per_node=false
    sum by (k8s_node_name) (max by (k8s_node_name, hw_type, hw_id) (rate(hw_energy_joules_total{hw_type=~"cpu|gpu"}[5m])) or on (k8s_node_name, hw_type, hw_id) max by (k8s_node_name, hw_type, hw_id) (hw_power_watts{hw_type=~"cpu|gpu"}))
fallback group="k8s_node_name" per_node=false
    sum by (k8s_node_name) (max by (k8s_node_name, hw_type, hw_id) (rate(hw_energy_joules_total{hw_type=~"cpu|gpu"}[5m]) * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info and on (job, instance) rate(hw_energy_joules_total{hw_type=~"cpu|gpu"}[5m]))) or on (k8s_node_name, hw_type, hw_id) max by (k8s_node_name, hw_type, hw_id) (hw_power_watts{hw_type=~"cpu|gpu"} * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info and on (job, instance) hw_power_watts{hw_type=~"cpu|gpu"})))

