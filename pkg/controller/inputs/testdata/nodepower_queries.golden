preset=otel window=1m30s node_label=node
primary group="node" per_node=false
    sum by (node) (max by (node, hw_type, hw_id) (rate(hw_energy_joules_total{hw_type=~"cpu|gpu"}[90s])) or on (node, hw_type, hw_id) max by (node, hw_type, hw_id) (hw_power_watts{hw_type=~"cpu|gpu"}))
fallback group="node" per_node=false
    sum by (node) (max by (node, hw_type, hw_id) (rate(hw_energy_joules_total{hw_type=~"cpu|gpu"}[90s]) * on (job, instance) group_left (node) max by (job, instance, node) (target_info and on (job, instance) rate(hw_energy_joules_total{hw_type=~"cpu|gpu"}[90s]))) or on (node, hw_type, hw_id) max by (node, hw_type, hw_id) (hw_power_watts{hw_type=~"cpu|gpu"} * on (job, instance) group_left (node) max by (job, instance, node) (target_info and on (job, instance) hw_power_watts{hw_type=~"cpu|gpu"})))

